<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>burstwaitress</AssemblyName>
    <RootNamespace>BurstWaitress</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Waitress.Common/Waitress.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Editor\**" />
    <EmbeddedResource Include="Editor\BurstWaitressEditor.cs" LogicalName="BurstWaitressEditor.cs" />
    <EmbeddedResource Include="Docs\*.md" />
    <EmbeddedResource Include="Testing\Data\*.asm" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
